                        <Image Source="{x:Bind Thumbnail}" Width="{x:Bind ThumbnailWidth}" Height="{x:Bind ThumbnailHeight}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
