                <FontIcon Glyph="" FontSize="14" VerticalAlignment="Center" />
                <TextBlock x:Name="DoneLabel" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="ExportButton" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" IsEnabled="False" AutomationProperties.Name="导出已确认的图片" VerticalContentAlignment="Center" Height="32" Padding="10,4">
