        </UserControl>
      </TitleBar.LeftHeader>
      <TitleBar.RightHeader>
        <UserControl x:Name="HeaderActions">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,4,0" VerticalAlignment="Center" Height="48">
            <Button x:Name="DoneButton" Click="DoneClick" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" VerticalAlignment="Center" Height="32" Padding="10,4">
