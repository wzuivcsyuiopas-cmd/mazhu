                <FontIcon Glyph="" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="导出" VerticalAlignment="Center" />
                <FontIcon Glyph="" FontSize="10" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout>
                  <MenuFlyoutItem Text="PNG 图片文件夹…" Icon="Folder" Click="ExportFolderClick" />
                  <MenuFlyoutItem Text="ZIP 压缩包…" Icon="Save" Click="ExportZipClick" />
